# system.prop for blackberry_sdm660
#

# Audio
persist.sys.smartamp=1

# Bluetooth
bt.max.hfpclient.connections=1
persist.bt.a2dp.aac_disable=false
persist.sys.bt_debug_log_enable=false
persist.sys.wbg.bt.service=false
persist.sys.wbg.bt=btstop
ro.bluetooth.emb_wp_mode=true

# Camera
camera.hal1.packagelist=com.dw.btime
persist.camera.HAL3.enabled=1
persist.camera.awbdefine=1
persist.camera.debug_img_exif=1
persist.camera.privapp.list=org.codeaurora.snapcam

# Graphics
debug.hwui.skia_atrace_enabled=false
dev.pm.dyn_samplingrate=1
persist.demo.hdmirotationlock=false
sdm.debug.disable_skip_validate=1

# IMS
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Logging
ro.logd.kernel=false

# Media
media.settings.xml=/vendor/etc/media_profiles_V1_0.xml
media.stagefright.thumbnail.prefer_hw_codecs=true
vidc.enc.target_support_bframe=1

# NFC
ro.nfc.port=I2C

# RIL
ril.subscription.types=NV,RUIM
ro.telephony.call_ring.multiple=false
ro.telephony.default_network=22,20
telephony.lteOnCdmaDevice=1
ro.telephony.handle_audio_direction_changes_between_call_state_changes=false

# Sensors
ro.qti.sensors.dev_ori=false

# Time
persist.timed.enable=true

# WFD
persist.debug.wfd.enable=0
persist.hwc.enable_vds=1
persist.sys.wfd.virtual=0

# Wi-Fi
persist.sys.wifi_log_enable=false
ro.wifi.power.reduction=1


#
# from device/bbry/athena/system.prop
#
#
# system.prop for sdm660

debug.sf.enable_hwc_vds=1
debug.sf.hw=1
debug.gralloc.enable_fb_ubwc=1

#ro.hdmi.enable=true

#system props for the MM modules
media.stagefright.enable-player=true
media.stagefright.enable-http=true
media.stagefright.enable-aac=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
mmp.enable.3g2=true
media.aac_51_output_enabled=true
mm.enable.smoothstreaming=true
# start:BBSECURE_ATHENA4RP
# end:BBSECURE_ATHENA4RP
#codecs:(PARSER_)AAC AC3 AMR_NB AMR_WB ASF AVI DTS FLV 3GP 3G2 MKV MP2PS MP2TS MP3 OGG QCP WAV FLAC AIFF APE DSD
persist.mm.enable.prefetch=true

# Additional buffers shared between Camera and Video
vidc.enc.dcvs.extra-buff-count=2

#Netflix custom property
ro.netflix.bsp_rev=Q660-13149-1

# System property for cabl
ro.qualcomm.cabl=0

#Simulate sdcard on /data/media
#
persist.fuse_sdcard=true

#
#snapdragon value add features
#

#enable offload audio video playback by default
#KRAB
#audio.offload.video=true

#system prop for RmNet Data
persist.data.df.dev_name=rmnet0

#
# system property determining camera HAL to be used for a Video call
#
# 1 is camera1
# 2 or anything else is camera2
persist.radio.VT_CAM_INTERFACE=2

#hwui properties
ro.hwui.texture_cache_size=72
ro.hwui.layer_cache_size=48
ro.hwui.r_buffer_cache_size=8
ro.hwui.path_cache_size=32
ro.hwui.gradient_cache_size=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=2048

#set maximum supported adapter voltage
persist.chg.max_volt_mv=9000

# Use fourteen voice volume steps
ro.config.vc_call_vol_steps=14

# Use thirty media volume steps
ro.config.media_vol_steps=30

# Note: Notification and ring volume steps cannot be set here. Instead, they are set in 
# device/blackberry/[athena or luna]/overlay/frameworks/base/core/res/res/values/config.xml.

# Disable app link domain verification
debug.pm.disable_app_link_verification=true

# Reduce UI animation stutter
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# Updater URL
lineage.updater.uri=https://raw.githubusercontent.com/Lineage-BBKey2/distribution/main/{device}.json
