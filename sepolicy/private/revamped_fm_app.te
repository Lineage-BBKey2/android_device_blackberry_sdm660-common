# RevampedFMRadio runs with the system UID but has a dedicated domain so
# Qualcomm FM access does not have to be granted to every system_app.
typeattribute revamped_fm_app coredomain;

app_domain(revamped_fm_app)

# Access RevampedFMRadio's system-UID application data. MCS categories
# assigned by seapp_contexts restrict this access to the app's own data.
allow revamped_fm_app system_app_data_file:dir create_dir_perms;
allow revamped_fm_app system_app_data_file:{ file lnk_file } create_file_perms;

# Permit discovery of ordinary framework APIs available to applications.
allow revamped_fm_app app_api_service:service_manager find;

# Access Android's audio and media services for playback, routing,
# recording, and media metrics.
allow revamped_fm_app audioserver_service:service_manager find;
allow revamped_fm_app mediaserver_service:service_manager find;
allow revamped_fm_app mediametrics_service:service_manager find;

# Query telephony state so FM playback can respond to calls.
allow revamped_fm_app radio_service:service_manager find;
