    name: "libkeymasterprop",
    owner: "blackberry",
    vendor: true,
    compile_multilib: "both",
    srcs: ["keymasterprop.c"],
    header_libs: ["libcutils_headers"],
    shared_libs: ["libcutils"],
    stl: "none",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
