# Touchscreen
on post-fs-data
    chown system system /sys/devices/virtual/tp_device/tp_glove/glove_enable
    chown system system /sys/devices/virtual/tp_device/tp_button/button_enable
    chown system system /sys/class/tp_device/tp_gesture/gesture_enable
    chmod 0644 /sys/devices/virtual/tp_device/tp_glove/glove_enable
    chmod 0644 /sys/devices/virtual/tp_device/tp_button/button_enable
    chmod 0644 /sys/class/tp_device/tp_gesture/gesture_enable

# Power
on property:sys.boot_completed=1
    # Enable PowerHAL hint processing
    setprop vendor.powerhal.init 1

# RIL
on boot
    enable vendor.qcrild
    enable vendor.qcrild2

on property:vendor.subsys_state_notifier.modem.state=OFFLINE
    stop vendor.qcrild
    stop vendor.qcrild2

on property:vendor.subsys_state_notifier.modem.state=ONLINE
    start vendor.qcrild
    start vendor.qcrild2

on property:init.svc.vendor.qcrild=stopped
    stop vendor.radio-config-1-1-wrapper
